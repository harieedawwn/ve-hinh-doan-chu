{
  "name": "ve-hinh-doan-chu",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Vẽ hình đoán chữ - online multiplayer draw-and-guess game (Cloudflare Workers + Durable Objects)",
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "dev:client": "vite --config vite.config.ts",
    "build": "vite build --config vite.config.ts",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "words:check": "node --experimental-strip-types scripts/check-words.ts",
    "loadtest": "node --experimental-strip-types scripts/loadtest.ts",
    "e2e": "node --experimental-strip-types scripts/e2e-canvas.ts"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261110.1",
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "playwright-core": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "wrangler": "^4.160.1",
    "ws": "^8.22.2"
  },
  "dependencies": {
    "preact": "^11.2.0"
  }
}
